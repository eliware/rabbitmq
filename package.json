{
    "name": "@eliware/rabbitmq",
    "type": "module",
    "version": "1.1.8",
    "engines": {
        "node": ">=26"
    },
    "description": "A small, testable ESM RabbitMQ publish and consume client for Node.js",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "RELEASE_NOTES.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/rabbitmq.git"
    },
    "keywords": [
        "amqp",
        "amqp-client",
        "esmodule",
        "exchange",
        "message-broker",
        "messaging",
        "nodejs",
        "pubsub",
        "queue",
        "rabbitmq",
        "testable"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/rabbitmq/issues"
    },
    "homepage": "https://github.com/eliware/rabbitmq#readme",
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "typescript": "^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@eliware/log": "^2.0.0",
        "amqplib": "^2.0.1"
    }
}
