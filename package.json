{
  "name": "@eliware/rabbitmq",
  "type": "module",
  "version": "1.1.1",
  "description": "A simple, testable RabbitMQ client for Node.js supporting both ESM and CommonJS.",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    }
  },
  "scripts": {
    "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
    "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'",
    "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/rabbitmq.git"
  },
  "keywords": [
    "rabbitmq",
    "nodejs",
    "amqp",
    "messaging",
    "queue",
    "pubsub",
    "esmodule",
    "commonjs",
    "testable"
  ],
  "author": "Eli Sterling, eliware.org <eli@eliware.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eliware/rabbitmq/issues"
  },
  "homepage": "https://github.com/eliware/rabbitmq#readme",
  "devDependencies": {
    "jest": "^30.0.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).mjs",
      "**/?(*.)+(spec|test).cjs"
    ]
  },
  "dependencies": {
    "@eliware/log": "^1.1.1",
    "amqplib": "^0.10.8"
  }
}
